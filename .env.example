# Copia este archivo como .env y escribe tus credenciales locales de MySQL
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
# Opcionales (toman estos valores por defecto si no se definen):
# DB_NAME=biblioteca
# DB_HOST=localhost
# DB_PORT=3306

# Configuración de entorno (en producción usar DEBUG=False y una SECRET_KEY aleatoria)
# DEBUG=True
# SECRET_KEY=genera-una-clave-larga-y-aleatoria-para-produccion
# ALLOWED_HOSTS=127.0.0.1,localhost

# Opcional (CU-03 y RF-15): Si deseas enviar correos reales por SMTP (ej. Gmail),
# descomenta estas líneas en tu archivo .env local. Si las dejas comentadas,
# los correos se imprimirán automáticamente en la terminal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_de_16_caracteres
# Solo para pruebas locales con el reloj del sistema alterado (mantener False en producción):
# EMAIL_INSECURE_SSL=False
